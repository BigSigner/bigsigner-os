#!/bin/sh
#
# Dev image: keep /mnt/data in sync with the presence of the microSD data
# partition (mmcblk0p2), so the card can be pulled and reinserted at runtime
# without a reboot. Runs as a background daemon, started by S31data-automount.
#
# This is deliberately independent of mdev and the seedsigner app's microSD
# FIFO: it watches sysfs (kernel-maintained, always accurate) and manages the
# /dev node itself. That keeps it reliable even while the app is stopped for
# development -- a stopped app leaves /tmp/mdev_fifo without a reader, which
# blocks the (serial) mdev event loop, so an mdev-based remount could stall.

DATA_SYS="/sys/class/block/mmcblk0p2"
DATA_DEV="/dev/mmcblk0p2"
DATA_MNT="/mnt/data"

# A damaged ext4 (for example "orphan file block 0: bad checksum") makes
# mount fail. Repair it once while this partition is present, then stop
# calling mount so the same error is not retried every 2s. The flag resets
# when the partition disappears, so a reinserted card gets one more try.
repair_tried=0

while true; do
	if [ -e "$DATA_SYS/dev" ]; then
		# Partition present: ensure it is mounted.
		if ! grep -q " $DATA_MNT " /proc/mounts; then
			if [ "$repair_tried" -eq 0 ]; then
				[ -b "$DATA_DEV" ] || mknod "$DATA_DEV" b $(sed 's/:/ /' "$DATA_SYS/dev")
				mkdir -p "$DATA_MNT"
				if ! mount -t ext4 "$DATA_DEV" "$DATA_MNT" 2>/dev/null; then
					echo "data-automount: $DATA_DEV failed to mount, running e2fsck" > /dev/kmsg
					# Exit 1 means errors were corrected. Keep going and mount.
					e2fsck -fy "$DATA_DEV" >/dev/null 2>&1 || true
					if mount -t ext4 "$DATA_DEV" "$DATA_MNT" 2>/dev/null; then
						repair_tried=0
					else
						repair_tried=1
					fi
				fi
			fi
		fi
	else
		# Card/partition gone: lazily detach the now-stale mount and clean up
		# the dangling device node (lazy umount so a shell or the app holding
		# a path under /mnt/data cannot wedge it).
		if grep -q " $DATA_MNT " /proc/mounts; then
			umount -l "$DATA_MNT" 2>/dev/null
		fi
		[ -b "$DATA_DEV" ] && rm -f "$DATA_DEV"
		repair_tried=0
	fi
	sleep 2
done
